{{- $tls := call .TLSConfigOptions (or (index . "SSLProtocol") "") (or (index . "SSLCipherSuite") "") -}}
[client]
ssl
{{ if $tls.CipherSuite -}}
ssl-cipher = {{ $tls.CipherSuite }}
{{ end -}}
{{ if $tls.Protocol -}}
tls-version = {{ $tls.Versions }}
{{ end -}}

[sst]
sockopt = cipher={{ if $tls.CipherSuite }}{{ or $tls.LegacyCiphers "DEFAULT" }}{{ else }}!SSLv2:kEECDH:kRSA:kEDH:kPSK:+3DES:!aNULL:!eNULL:!MD5:!EXP:!RC4:!SEED:!IDEA:!DES:!SSLv3:!TLSv1{{ end }}{{ if $tls.Protocol }},{{ $tls.SocketOptions }}{{ end }}
tcert = /etc/pki/tls/certs/galera.crt
tkey = /etc/pki/tls/private/galera.key
tca = /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
encrypt = 3
ssl-mode = REQUIRED
