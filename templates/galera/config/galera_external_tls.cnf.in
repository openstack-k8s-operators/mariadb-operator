{{- $tls := call .TLSConfigOptions (or (index . "SSLProtocol") "") (or (index . "SSLCipherSuite") "") -}}
[mysqld]
ssl
ssl-cert = /etc/pki/tls/certs/galera.crt
ssl-key = /etc/pki/tls/private/galera.key
ssl-cipher = {{ or $tls.CipherSuite "!SSLv2:kEECDH:kRSA:kEDH:kPSK:+3DES:!aNULL:!eNULL:!MD5:!EXP:!RC4:!SEED:!IDEA:!DES:!SSLv3:!TLSv1" }}
{{ if $tls.Protocol -}}
tls-version = {{ $tls.Versions }}
{{ end -}}

[sst]
ssl-mode = DISABLED
